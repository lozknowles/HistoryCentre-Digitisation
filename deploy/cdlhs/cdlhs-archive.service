[Unit]
Description=CDLHS public demonstration archive and private enquiry inbox
After=network.target

[Service]
Type=simple
User=cdlhs-archive
Group=cdlhs-archive
WorkingDirectory=/var/www/cdlhs-archive/current/catalogue
EnvironmentFile=/var/www/cdlhs-archive/runtime/public.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CDLHS_HOSTED=1
ExecStart=/var/www/cdlhs-archive/current/.venv/bin/gunicorn --bind 127.0.0.1:18674 --workers 1 --threads 2 --timeout 45 --max-requests 1000 --max-requests-jitter 100 run_public:app
Restart=on-failure
RestartSec=4
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/cdlhs-archive/runtime
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M
TasksMax=32

[Install]
WantedBy=multi-user.target
